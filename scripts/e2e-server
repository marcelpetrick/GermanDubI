#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
runtime="$(mktemp -d)"
cleanup() {
  rm -rf "$runtime"
}
trap cleanup EXIT

cd "$repo_root"
uv run python -c \
  'import sys; from pathlib import Path; from backend.tests.fixtures.media import make_narration_video; make_narration_video(Path(sys.argv[1]), seconds=15)' \
  "$runtime/fixture.mp4"

export GERMANDUBI_DATA_DIR="$runtime/data"
export GERMANDUBI_FAKE_MEDIA_FIXTURE="$runtime/fixture.mp4"
export GERMANDUBI_TRANSCRIPTION_PROVIDER="fake"
export GERMANDUBI_TRANSLATION_PROVIDER="fake"
export GERMANDUBI_TTS_PROVIDER="fake"
export GERMANDUBI_SEPARATION_PROVIDER="fake"
export GERMANDUBI_WORKER_POLL_INTERVAL_S="0.05"

# Dedicated ports. The browser workflow must own the server it tests: sharing a
# developer's `make dev` meant testing real providers and real project data, which fails
# in a way that looks like a broken test rather than a misconfigured run.
export GERMANDUBI_PORT="8799"
export VITE_DEV_PORT="5199"
export VITE_API_TARGET="http://127.0.0.1:8799"

"$repo_root/scripts/dev"
